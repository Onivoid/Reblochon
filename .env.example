# PostgreSQL (docker compose)
POSTGRES_USER=reblochon
POSTGRES_PASSWORD=reblochon
POSTGRES_DB=reblochon
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql+psycopg://reblochon:reblochon@localhost:5432/reblochon
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (dev Vite; also used as docker build arg for full stack)
VITE_API_URL=http://localhost:8000
WEB_PORT=8080
